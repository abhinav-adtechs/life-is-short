#!/bin/sh
# Blocks commits that include key/secret or task files, or staged content
# that looks like a credential. Enable with: git config core.hooksPath .githooks

blocked_paths='(^|/)(\.env(\..*)?|.*\.(pem|key|p12|pfx|jks|keystore|gpg|asc|ppk)|id_(rsa|ed25519|ecdsa).*|secrets?(/|\..*)|.*credentials.*|service-account.*\.json|\.npmrc|\.pypirc|\.netrc|tasks?(/|\..*)|\.tasks/.*|todo\..*|.*\.tasks|\.claude/.*)$'
allowed_paths='(^|/)\.env\.example$'

files=$(git diff --cached --name-only --diff-filter=ACMR)
bad_files=$(printf '%s\n' "$files" | grep -iE "$blocked_paths" | grep -vE "$allowed_paths")
if [ -n "$bad_files" ]; then
  echo "pre-commit: refusing to commit key/secret or task files:" >&2
  printf '  %s\n' $bad_files >&2
  exit 1
fi

secret_patterns='-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{50,}|sk-[A-Za-z0-9_-]{20,}|xox[abpr]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}'
if git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -qE -- "$secret_patterns"; then
  echo "pre-commit: staged changes look like they contain a secret/API key." >&2
  echo "Remove it (use .env, which is gitignored) and try again." >&2
  exit 1
fi
