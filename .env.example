# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Supabase (Project settings -> API). Leave empty to run in local-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini, server only. Without it, dumps are sorted by the keyword parser.
GEMINI_API_KEY=
# Models to try in order (comma-separated). Default: gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_MODEL=

# Google Calendar / Tasks pull (Google Cloud OAuth client, type "Web application"), server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Search Console's HTML-tag token (the tag's content value), to prove you own the site for Google's
# OAuth review. Optional; see docs/go-live.md.
GOOGLE_SITE_VERIFICATION=

# Only for running without Supabase in production (e.g. a private preview). Leave unset on Vercel.
# ALLOW_LOCAL_MODE=1

# Sharing (view-only links, Settings → Sharing), server only. See docs/setup.md.
# A long random value (openssl rand -base64 33); the database keeps only its sha256.
SHARE_SERVER_KEY=
# Emails the viewer's sign-in code (resend.com). Without it, development prints codes to the server log.
RESEND_API_KEY=
# e.g. Life is short <share@yourdomain.com>, on a domain verified in Resend.
SHARE_EMAIL_FROM=
